generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum AccountStatus {
  PENDING
  APPROVED
  DISABLED
}

enum AdjustmentReason {
  RECEIVING
  CORRECTION
  DAMAGE
  IMPORT
  ORDER
  ORDER_CANCELLED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  name          String
  role          Role          @default(CUSTOMER)
  accountStatus AccountStatus @default(PENDING) @map("account_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  adjustments   StockAdjustment[]
  orders        Order[]
  cartLines     CartLine[]

  @@map("users")
}

/// Product line / grouping (e.g. "Sushi Containers") — contains orderable items
model Product {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  items     Item[]

  @@map("products")
}

/// Orderable SKU-level entry, stocked and sold by the case
model Item {
  id                String            @id @default(cuid())
  productId         String            @map("product_id")
  product           Product           @relation(fields: [productId], references: [id])
  sku               String?
  name              String
  detail            String?
  unitWeightG       Float?            @map("unit_weight_g")
  piecesPerCase     Int               @map("pieces_per_case")
  caseLengthCm      Float?            @map("case_length_cm")
  caseWidthCm       Float?            @map("case_width_cm")
  caseHeightCm      Float?            @map("case_height_cm")
  minOrderCases     Int               @default(1) @map("min_order_cases")
  stockCases        Int               @default(0) @map("stock_cases")
  lowStockThreshold Int               @default(10) @map("low_stock_threshold")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  adjustments       StockAdjustment[]
  images            ItemImage[]
  orderLines        OrderLine[]
  cartLines         CartLine[]

  @@index([productId])
  @@index([sku])
  @@map("items")
}

/// Item photo, stored in-DB as resized WebP (~800px). First by sortOrder = main image.
model ItemImage {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String   @map("mime_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId, sortOrder])
  @@map("item_images")
}

model StockAdjustment {
  id         String           @id @default(cuid())
  itemId     String           @map("item_id")
  item       Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String?          @map("user_id")
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  deltaCases Int              @map("delta_cases")
  reason     AdjustmentReason
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("stock_adjustments")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique @map("order_number")
  customerId   String      @map("customer_id")
  customer     User        @relation(fields: [customerId], references: [id])
  status       OrderStatus @default(PENDING)
  deliveryDate DateTime?   @map("delivery_date") @db.Date
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  lines        OrderLine[]

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

/// Line snapshots item facts at purchase time so history survives item edits
model OrderLine {
  id                    String  @id @default(cuid())
  orderId               String  @map("order_id")
  order                 Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId                String  @map("item_id")
  item                  Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qtyCases              Int     @map("qty_cases")
  snapshotName          String  @map("snapshot_name")
  snapshotSku           String? @map("snapshot_sku")
  snapshotProductName   String  @map("snapshot_product_name")
  snapshotPiecesPerCase Int     @map("snapshot_pieces_per_case")

  @@index([orderId])
  @@index([itemId])
  @@map("order_lines")
}

model CartLine {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String   @map("item_id")
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qtyCases  Int      @map("qty_cases")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, itemId])
  @@map("cart_lines")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}
