# Copy this file to .env and fill in real values. Never commit .env.

# Local dev database (matches docker-compose.yml). In production, use the Neon connection string.
DATABASE_URL="postgresql://wms:wms_dev_password@localhost:5432/wms?schema=public"

# Secret used to sign/derive session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-64-char-random-hex-string"
